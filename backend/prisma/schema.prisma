generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String        @unique
  passwordHash String        @map("password_hash")
  displayName  String?       @map("display_name")
  role         Role          @default(USER)
  /// Автосервис, в котором работает пользователь. Nullable только ради старых
  /// строк: сервис авторизации создаёт личную организацию при первом обращении.
  orgId        String?       @db.Uuid @map("org_id")
  orgRole      OrgRole       @default(MEMBER) @map("org_role")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull, map: "users_org_id_fkey")
  sessions     AuthSession[]
  vehicles     Vehicle[]
  orders       Order[]
  telegram     TelegramAccount?
  telegramCodes TelegramLinkCode[]
  devices      DeviceToken[]
  expertRequests ExpertRequest[]

  @@index([orgId], map: "users_org_id_idx")
  @@map("users")
}

/// Роль внутри автосервиса: владелец управляет настройками и наценкой,
/// сотрудник работает с гаражом, клиентами и заказами.
enum OrgRole {
  OWNER
  MEMBER

  @@map("org_role")
}

/// Автосервис (СТО) — рабочее пространство: общий гараж, клиенты, заказы и
/// наценка. Каждый пользователь состоит ровно в одной организации; при
/// регистрации без кода приглашения она создаётся автоматически.
model Organization {
  id               String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name             String
  phone            String?
  /// Наценка по умолчанию на закупочную цену, в базисных пунктах (10000 = 100%).
  defaultMarkupBps Int        @default(0) @map("default_markup_bps")
  /// Код приглашения: регистрация с ним ведёт сотрудника в эту организацию.
  inviteCode       String     @unique(map: "organizations_invite_code_key") @map("invite_code")
  /// Реквизиты исполнителя для заказ-наряда (ПП РФ № 780 от 29.05.2025, п. 9(а)):
  /// наименование юрлица/ИП, ИНН, ОГРН/ОГРНИП, адрес. Пусто — печатается название.
  legalName        String?    @map("legal_name")
  inn              String?
  ogrn             String?
  address          String?
  /// Гарантийные обязательства (п. 9(з)) — текст в заказ-наряде.
  warrantyText     String?    @map("warranty_text")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  members          User[]
  vehicles         Vehicle[]
  customers        Customer[]
  orders           Order[]
  expertRequests   ExpertRequest[]

  @@map("organizations")
}

/// Клиент автосервиса — владелец машины. Не пользователь системы: его заводит
/// приёмщик, чтобы привязать авто и заказ к человеку и телефону.
model Customer {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId        String       @db.Uuid @map("org_id")
  name         String
  phone        String?
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, map: "customers_org_id_fkey")
  vehicles     Vehicle[]
  orders       Order[]

  @@index([orgId, name], map: "customers_org_id_name_idx")
  @@map("customers")
}

/// Роль пользователя: клиент (свой кабинет) или оператор автосервиса (ведёт чужие заказы).
enum Role {
  USER
  OPERATOR

  @@map("user_role")
}

/// Push-токен устройства (Expo) для уведомлений.
model DeviceToken {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "device_tokens_user_id_fkey")

  @@index([userId], map: "device_tokens_user_id_idx")
  @@map("device_tokens")
}

/// Привязка Telegram-аккаунта к пользователю (1:1).
model TelegramAccount {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @unique @db.Uuid @map("user_id")
  telegramUserId BigInt   @unique @map("telegram_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "telegram_accounts_user_id_fkey")

  @@map("telegram_accounts")
}

/// Одноразовый код привязки Telegram (генерируется в вебе, гасится ботом).
model TelegramLinkCode {
  code      String   @id
  userId    String   @db.Uuid @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "telegram_link_codes_user_id_fkey")

  @@index([userId], map: "telegram_link_codes_user_id_idx")
  @@map("telegram_link_codes")
}

/// Автомобиль в гараже автосервиса. Общий для всех сотрудников организации;
/// `userId` — кто добавил. Госномер и пробег — то, чем оперирует приёмщик:
/// машину ищут по номеру, а регламент ТО считают от пробега.
model Vehicle {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String        @db.Uuid @map("user_id")
  orgId        String?       @db.Uuid @map("org_id")
  customerId   String?       @db.Uuid @map("customer_id")
  vin          String
  plate        String?
  mileageKm    Int?          @map("mileage_km")
  make         String
  model        String
  /// null — каталог год не отдал (европейские VIN его не кодируют).
  year         Int?
  engine       String?
  bodyType     String?       @map("body_type")
  nickname     String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "vehicles_user_id_fkey")
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade, map: "vehicles_org_id_fkey")
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "vehicles_customer_id_fkey")

  @@unique([orgId, vin], map: "vehicles_org_id_vin_key")
  @@index([orgId, plate], map: "vehicles_org_id_plate_idx")
  @@index([customerId], map: "vehicles_customer_id_idx")
  @@map("vehicles")
}

enum OrderStatus {
  DRAFT
  PLACED
  PAID
  PROCESSING
  READY
  COMPLETED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

/// Заказ. Черновик (DRAFT) играет роль корзины — у пользователя он один.
model Order {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Человекочитаемый номер: его диктуют по телефону и пишут в смете.
  number     Int         @unique(map: "orders_number_key") @default(autoincrement())
  userId     String      @db.Uuid @map("user_id")
  /// Автосервис-владелец заказа: заказы видны всем сотрудникам организации.
  orgId      String?     @db.Uuid @map("org_id")
  /// Клиент автосервиса, для чьей машины заказ (для сметы и истории).
  customerId String?     @db.Uuid @map("customer_id")
  status     OrderStatus @default(DRAFT)
  /// Гарантирует единственность корзины: = userId, пока заказ DRAFT, и null после
  /// оформления. Уникальность (NULL допускают дубли) не даёт создать два черновика.
  draftKey   String?     @unique @map("draft_key")
  vehicleVin String?     @map("vehicle_vin")
  notes      String?
  /// Приём машины для заказ-наряда (ПП № 780, п. 9 и п. 12): срок исполнения,
  /// причина обращения, комплектность и повреждения, госномер и пробег на момент приёма.
  dueAt          DateTime? @map("due_at")
  complaint      String?
  conditionNotes String?   @map("condition_notes")
  plate          String?
  mileageKm      Int?      @map("mileage_km")
  currency   String      @default("RUB")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  placedAt   DateTime?   @map("placed_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "orders_user_id_fkey")
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade, map: "orders_org_id_fkey")
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "orders_customer_id_fkey")
  items        OrderItem[]
  works        OrderWork[]
  payments     Payment[]

  @@index([userId, status], map: "orders_user_id_status_idx")
  @@index([orgId, status, placedAt], map: "orders_org_id_status_placed_at_idx")
  @@map("orders")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED

  @@map("payment_status")
}

/// Платёж по заказу. Провайдер-агностично: mock сейчас, ЮKassa позже.
model Payment {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId           String        @db.Uuid @map("order_id")
  userId            String        @db.Uuid @map("user_id")
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus @default(PENDING)
  method            String?
  amount            Int
  currency          String
  confirmationUrl   String?       @map("confirmation_url")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  paidAt            DateTime?     @map("paid_at")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "payments_order_id_fkey")
  refunds           Refund[]

  @@index([orderId], map: "payments_order_id_idx")
  @@index([providerPaymentId], map: "payments_provider_payment_id_idx")
  @@map("payments")
}

/// Возврат средств по платежу.
model Refund {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId        String        @db.Uuid @map("payment_id")
  orderId          String        @db.Uuid @map("order_id")
  userId           String        @db.Uuid @map("user_id")
  amount           Int
  currency         String
  status           PaymentStatus @default(PENDING)
  providerRefundId String?       @map("provider_refund_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "refunds_payment_id_fkey")

  @@index([orderId], map: "refunds_order_id_idx")
  @@map("refunds")
}

/// Позиция заказа — снимок предложения на момент добавления (цена авторитетна с сервера).
model OrderItem {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId       String   @db.Uuid @map("order_id")
  oemNumber     String   @map("oem_number")
  partName      String   @map("part_name")
  brand         String
  articleNumber String   @map("article_number")
  supplierName  String   @map("supplier_name")
  quality       String
  isOriginal    Boolean  @map("is_original")
  tier          String?
  /// Закупочная цена у поставщика (копейки) — то, что платит автосервис.
  priceAmount   Int      @map("price_amount")
  /// Цена для клиента автосервиса (копейки): закуп × наценка, можно править вручную.
  saleAmount    Int      @default(0) @map("sale_amount")
  /// Наценка, применённая при добавлении (базисные пункты), — для отчёта по марже.
  markupBps     Int      @default(0) @map("markup_bps")
  currency      String
  deliveryDays  Int      @map("delivery_days")
  quantity      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "order_items_order_id_fkey")

  @@index([orderId], map: "order_items_order_id_idx")
  @@map("order_items")
}

/// Работа (услуга) в заказ-наряде — вторая половина документа рядом с запчастями:
/// наименование, цена, количество (ПП № 780, п. 9(е)). Цена — для клиента, в копейках.
model OrderWork {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId     String   @db.Uuid @map("order_id")
  name        String
  priceAmount Int      @map("price_amount")
  currency    String   @default("RUB")
  quantity    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "order_works_order_id_fkey")

  @@index([orderId], map: "order_works_order_id_idx")
  @@map("order_works")
}

model AuthSession {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @db.Uuid @map("user_id")
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

/// Кэш перевода текстов каталога на русский: названия деталей и категории
/// приходят от EPC-провайдеров латиницей/иероглифами. Перевод платный, поэтому
/// одна исходная строка переводится один раз и переиспользуется всеми
/// пользователями (см. CatalogTranslator).
model CatalogTranslation {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Исходный текст провайдера как есть — ключ кэша.
  source    String   @unique(map: "catalog_translations_source_key")
  ru        String
  /// Чем переведено: модель ИИ. Нужно для точечного сброса при смене модели.
  model     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("catalog_translations")
}

/// Кэш расшифровки VIN: карточка автомобиля от каталога целиком (включая raw с
/// меткой источника). Повторный поиск по той же машине не тратит платный вызов
/// внешнего каталога и не ждёт его. См. CachingCatalogProvider.
model VinDecode {
  /// Нормализованный VIN/frame — ключ кэша.
  vin       String   @id
  vehicle   Json
  /// Имя каталога-источника («acat», «vin17»…) — для аналитики покрытия.
  source    String
  hitCount  Int      @default(0) @map("hit_count")
  decodedAt DateTime @default(now()) @map("decoded_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt], map: "vin_decodes_expires_at_idx")
  @@map("vin_decodes")
}

enum ExpertRequestStatus {
  NEW
  ANSWERED
  REJECTED

  @@map("expert_request_status")
}

/// Заявка «не нашли деталь — спросить эксперта». Сотрудник автосервиса
/// описывает, что искал по этому VIN; оператор платформы подбирает каталожные
/// номера вручную и отвечает. Ответ уходит автору push/Telegram-уведомлением.
model ExpertRequest {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  number       Int                 @unique(map: "expert_requests_number_key") @default(autoincrement())
  orgId        String              @db.Uuid @map("org_id")
  userId       String              @db.Uuid @map("user_id")
  vin          String
  /// Снимок карточки авто на момент заявки (марка/модель/год), если VIN опознан.
  vehicle      Json?
  query        String
  comment      String?
  status       ExpertRequestStatus @default(NEW)
  answerText   String?             @map("answer_text")
  /// Каталожные номера от эксперта — по ним сразу ищутся предложения.
  answerOems   String[]            @default([]) @map("answer_oems")
  answeredBy   String?             @db.Uuid @map("answered_by")
  answeredAt   DateTime?           @map("answered_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade, map: "expert_requests_org_id_fkey")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "expert_requests_user_id_fkey")

  @@index([status, createdAt], map: "expert_requests_status_created_at_idx")
  @@index([orgId, createdAt], map: "expert_requests_org_id_created_at_idx")
  @@map("expert_requests")
}

/// Контекст чата Telegram-бота между рестартами процесса: VIN, последняя
/// выдача и предложения. Без него после деплоя мастер получал «сначала
/// пришлите VIN» посреди разговора.
model BotSession {
  chatId    BigInt   @id @map("chat_id")
  state     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bot_sessions")
}
