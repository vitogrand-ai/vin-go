# Local PostgreSQL from ../docker-compose.yml.
# Keep an explicit username and password in Prisma URLs even on local machines.
# Peer-auth style URLs without a user can produce opaque Prisma schema-engine errors.
DATABASE_URL="postgresql://superuser:superpassword@localhost:54329/web_app_demo?schema=public"

# Test PostgreSQL from ../docker-compose.yml. Backend integration, Docker smoke,
# and Playwright E2E use this shape and must target the *_test database.
TEST_DATABASE_URL="postgresql://superuser:superpassword@localhost:54330/web_app_demo_test?schema=public"

JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGINS="http://localhost:5173,http://localhost:8081,http://localhost:19006"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
COOKIE_SECURE="false"

# Optional DigitalOcean Spaces storage. Leave blank until the product needs
# uploads, media, or other persistent files.
SPACES_REGION=""
SPACES_BUCKET=""
SPACES_ENDPOINT=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
SPACES_UPLOAD_MAX_BYTES="10485760"
SPACES_UPLOAD_URL_TTL_SECONDS="900"
SPACES_DOWNLOAD_URL_TTL_SECONDS="300"
SPACES_PUBLIC_CACHE_CONTROL="public, max-age=31536000, immutable"

# Оплата через ЮKassa. Пусто — используется мок-провайдер (тестовая оплата на /pay).
# Задавайте оба значения вместе, чтобы включить боевой провайдер.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Куда ЮKassa вернёт пользователя после оплаты (страница заказов вебаппа).
PAYMENT_RETURN_URL=""
# Фискализация 54-ФЗ: код ставки НДС ЮKassa (1=без НДС, 3=10%, 4=20% и т.д.).
# Задан — к платежу и возврату прикладывается чек (нужна касса/ОФД в ЛК ЮKassa).
# Пусто — фискализация выключена.
YOOKASSA_VAT_CODE=""
# Ограничивать webhook оплаты диапазонами IP ЮKassa (defense-in-depth).
# true — только за доверенным прокси, проставляющим X-Forwarded-For (App Platform).
YOOKASSA_WEBHOOK_IP_ALLOWLIST="false"

# Rate limiting (in-memory, на инстанс). Пусто — выключено. Задавайте в проде.
# Лимит запросов на IP в окне; окно — RATE_LIMIT_WINDOW_SECONDS (по умолчанию 60).
RATE_LIMIT_AUTH_MAX=""        # напр. 10 — защита логина/регистрации от подбора
RATE_LIMIT_PUBLIC_MAX=""      # напр. 120 — всплески на публичном каталоге
RATE_LIMIT_WINDOW_SECONDS=""  # напр. 60

# --- Каталоги и поставщики (пусто — работают моки с демо-данными) ---

# Каталоги VIN→OEM. Ключ включает боевой источник; несколько — fallback-цепочка.
ACAT_API_KEY=""         # acat.online — широкий primary-каталог
PARTSINDEX_API_KEY=""   # parts-index.ru — свежие китайские бренды + кроссы
EPCDATA_API_KEY=""      # JDM-каталог (правый руль, frame-номера)

# Каталог 17vin.com — китайский EPC (VIN→авто→оригинальные детали).
# Логин+пароль тестового/боевого аккаунта задаются вместе.
# Тариф: $0.15 за VIN; повторные запросы по тому же VIN 3 месяца бесплатны.
VIN17_USER=""
VIN17_PASSWORD=""

# Реестр госномер→VIN (Avtocod).
AVTOCOD_API_KEY=""

# Поставщик на платформе ABCP — например 4mycar.ru. Как получить доступ:
# зарегистрируйте аккаунт покупателя на 4mycar.ru и запросите у их поддержки
# включение API-доступа — выдадут хост клиентского API вида
# https://idNNNN.public.api.abcp.ru. Все ТРИ значения задаются вместе.
# ABCP_LOGIN — логин аккаунта, ABCP_PASSWORD — пароль ОТКРЫТЫМ текстом
# (md5-хэш для API считается в коде сам).
ABCP_API_URL=""
ABCP_LOGIN=""
ABCP_PASSWORD=""

# Поставщик Emex — второй источник предложений (выдачи сливаются с ABCP).
EMEX_API_KEY=""

# Telegram-бот подбора по VIN. Получите токен у @BotFather. Запуск: bun run start:bot.
# Пусто — бот не запускается.
TELEGRAM_BOT_TOKEN=""
# Имя бота без @ (для deep-link привязки t.me/<bot>?start=<код>).
TELEGRAM_BOT_USERNAME=""
